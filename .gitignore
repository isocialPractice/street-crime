.claude/
.prompts/

# A local bug inbox: notes, GIFs and screenshots of bugs seen in play.
.bug-fix/

# Agent skills installed from skills/ (npm run skills). skills/ is the copy to
# edit and commit; these are made from it. .claude/ above covers Claude Code's.
.github/skills/level-design/
.agents/skills/level-design/
updateAssets.bat
updateAnimate.bat
updateAll.bat
userScripts/
support/

# Folders waiting on artwork are kept by a .gitkeep, and git stores files
# rather than folders, so without this they would not survive a clone. The
# negation is here because a global ignore of dotfiles is common and a
# repository should not depend on anyone's personal config to check out whole.
!.gitkeep
!**/.gitkeep
